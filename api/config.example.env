# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
# Copia este archivo a .env y ajusta los valores

# Entorno de la aplicación (development o production)
APP_ENV=development

# Modo debug (true para desarrollo, false para producción)
APP_DEBUG=true

# URL base de la aplicación (sin slash al final)
APP_URL=http://localhost/caminemos-juntos-php


# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================

# Host de la base de datos
DB_HOST=localhost

# Nombre de la base de datos
DB_NAME=caminemos_juntos

# Usuario de MySQL
DB_USER=root

# Contraseña de MySQL (vacía en Laragon por defecto)
DB_PASSWORD=


# ============================================
# CONFIGURACIÓN DE PAYU LATAM
# ============================================

# ID del comercio en PayU
PAYU_MERCHANT_ID=508029

# Llave API de PayU
PAYU_API_KEY=4Vj8eK4rloUd272L48hsrarnUA

# Login API de PayU
PAYU_API_LOGIN=pRRXKOl8ikMmt9u

# ID de la cuenta en PayU
PAYU_ACCOUNT_ID=512321

# Modo de prueba (true para sandbox, false para producción)
PAYU_TEST_MODE=true


# ============================================
# URLS DE CALLBACK DE PAYU
# ============================================

# URL de respuesta (donde el usuario es redirigido después del pago)
PAYU_RESPONSE_URL=http://localhost/caminemos-juntos-php/api/payu/response.php

# URL de confirmación (donde PayU envía la confirmación del pago)
PAYU_CONFIRMATION_URL=http://localhost/caminemos-juntos-php/api/payu/confirmation.php


# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. NUNCA subas el archivo .env a Git o repositorios públicos
# 2. Para producción, cambia APP_ENV=production y APP_DEBUG=false
# 3. En producción, usa HTTPS en todas las URLs
# 4. Para pagos reales, cambia PAYU_TEST_MODE=false y usa credenciales de producción
# 5. Las credenciales de PayU Sandbox son para pruebas únicamente
#
