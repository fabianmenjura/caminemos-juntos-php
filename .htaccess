RewriteEngine On

# Redirigir /api a la carpeta api (que redirige al backend)
# IMPORTANTE: Esta regla debe ir ANTES de las otras
# Pasar el header Authorization
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php?route=$1 [L,QSA,E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Servir archivos del frontend desde la raíz
# Si la petición es para un archivo o directorio que existe en frontend/, servirlo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{DOCUMENT_ROOT}/frontend%{REQUEST_URI} -f
RewriteRule ^(.*)$ frontend/$1 [L]

# Redirigir rutas sin extensión a frontend/index.html (SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/backend/
RewriteRule ^.*$ frontend/index.html [L]

# Prevenir listado de directorios
Options -Indexes
