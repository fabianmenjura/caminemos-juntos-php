RewriteEngine On

# Redirigir /api a la carpeta backend (mantener URL /api)
RewriteRule ^api/(.*)$ backend/index.php/$1 [L,QSA]

# Servir archivos del frontend desde la raíz
# Si la petición es para un archivo o directorio que existe en frontend/, servirlo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{DOCUMENT_ROOT}/frontend%{REQUEST_URI} -f
RewriteRule ^(.*)$ frontend/$1 [L]

# Redirigir rutas sin extensión a frontend/index.html (SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/backend/
RewriteRule ^.*$ frontend/index.html [L]

# Prevenir listado de directorios
Options -Indexes
