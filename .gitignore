# =====================================================
# GIT IGNORE - Caminemos Juntos
# =====================================================

# Configuración local
api/.env
.env

# Logs
logs/*.log
!logs/.gitkeep

# Imágenes subidas por usuarios
assets/images/uploads/*
!assets/images/uploads/.gitkeep

# Archivos temporales de PHP
*.tmp
*.bak
*.swp
*~

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.sublime-*

# Composer (si se usa en el futuro)
vendor/
composer.lock

# Node modules (si se usa en el futuro)
node_modules/
package-lock.json

# Archivos de prueba
test-*.php
test-*.html
verificar-*.php

# Backups
*.sql.backup
*.sql.bak
backup/

# Documentación temporal
*.tmp.md
